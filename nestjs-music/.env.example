# Puerto en el que escucha la aplicación (src/main.ts lo lee con ConfigService).
PORT=3300

# NestJS Observe (https://observe.nestjs.com) - opcional.
# Copiá este archivo como .env y completá las claves desde el dashboard.
# Mientras estén vacías, la telemetría queda desactivada.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
