# =============================================================================
# .env.example — Variables de entorno del frontend
# -----------------------------------------------------------------------------
# Copiá este archivo a `.env.local` y completá los valores de tu máquina.
# `.env.local` NO se sube a git (está en .gitignore).
#
# API_BASE_URL: URL base del backend FastAPI. Se lee en next.config.ts (rewrites)
# y es una variable server-side: no se expone en el bundle del navegador.
# =============================================================================
API_BASE_URL=http://localhost:8000